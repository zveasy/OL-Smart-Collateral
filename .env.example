# ─────────────────────────────────────────────────────────────────────────────
# O&L Smart Collateral – environment template
# Copy to .env and set values. Never commit .env.
# ─────────────────────────────────────────────────────────────────────────────

# Kaleido (required)
KALEIDO_API_URL=https://your-gateway.us0-aws.kaleido.io/gateways/your-app
KALEIDO_API_KEY=your-kaleido-app-credentials
CARBON_CONTRACT_ADDRESS=0x0000000000000000000000000000000000000000
ADMIN_ADDRESS=0x0000000000000000000000000000000000000000

# REST API auth (optional; if set, all /carbon/* routes require this key)
# API_KEY=your-secret-api-key

# CORS (optional; default * for dev; set to https://your-frontend.com in prod)
# CORS_ALLOW_ORIGINS=https://app.example.com

# Logging (optional)
# LOG_LEVEL=INFO
# LOG_FORMAT=json

# Docs (optional; /docs and /redoc disabled when ENVIRONMENT=production or DOCS_ENABLED=false)
# ENVIRONMENT=production
# DOCS_ENABLED=true
