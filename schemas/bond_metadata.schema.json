{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://omniluci.com/schemas/bond_metadata.schema.json",
  "title": "OL Green-Bond Metadata",
  "type": "object",
  "required": [
    "name",
    "issuer",
    "isin",
    "currency",
    "faceValue",
    "couponRate",
    "couponFrequency",
    "issueDate",
    "maturity",
    "esgScore",
    "metadataVersion"
  ],
  "additionalProperties": false,

  "properties": {
    "name":          { "type": "string",  "minLength": 1 },
    "issuer":        { "type": "string",  "minLength": 1 },
    "isin":          { "type": "string",  "pattern": "^[A-Z]{2}[A-Z0-9]{9}[0-9]$" },
    "currency":      { "type": "string",  "pattern": "^[A-Z]{3}$" },
    "faceValue":     { "type": "string",  "pattern": "^[0-9]+\\.[0-9]{2}$" },
    "couponRate":    { "type": "number",  "minimum": 0, "maximum": 100 },
    "couponFrequency": {
      "enum": ["ANNUAL", "SEMI_ANNUAL", "QUARTERLY", "MONTHLY"]
    },
    "issueDate":     { "type": "string",  "format": "date" },
    "maturity":      { "type": "string",  "format": "date" },
    "isCallable":    { "type": "boolean", "default": false },
    "esgScore":      { "type": "integer", "minimum": 0, "maximum": 100 },
    "carbonOffsetTons": {
      "type": "string",
      "pattern": "^[0-9]+(\\.[0-9]{1,4})?$"
    },
    "externalId":    { "type": "string" },
    "metadataVersion": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    }
  }
}
